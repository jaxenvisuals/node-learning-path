<%- include('./includes/header.ejs')
    %>
</head>

<body>
  <%- include('./includes/navbar.ejs')
            %>

  <div class="container mt-5">

    <div>
      <div class="row align-items-start">
        <div class="col"></div>
        <div class="col">
          <div class="card">
            <div class="card-header">
              Signup
            </div>
            <div class="card-body">
              <% if(errorMessage) { %>
              <div class="alert alert-danger" role="alert">
                <%= errorMessage %>
              </div>
              <% } %>

              <h5 class="card-title">Create an account</h5>
              <p class="card-text">
                We sell all things related to bugs 🐞 and insects 🦟. I mean all things. You can find deadly
                python bugs and css bugs here!
              </p>


              <form class="row g-3" method="POST" action="/signup">
                <div class="col-md-12">
                  <label for="name" class="form-label">Name</label>
                  <input type="text" class="form-control" id="name" name="name">
                </div>
                <div class="col-md-12">
                  <label for="username" class="form-label">Username</label>
                  <input type="text" class="form-control" id="username" name="username">
                </div>
                <div class="col-md-12">
                  <label for="password" class="form-label">Password</label>
                  <input type="password" class="form-control" id="password" name="password">
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Be a bug 🐞</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="col"></div>
      </div>

    </div>

  </div>
</body>

<%- include('./includes/footer.ejs')
        %>